# Current mainline for gates (2026-11-22): 5d out-of-combat policy + honest K=64 + POTION_VALUE=10
# + root policy prior from the expert-iteration combat net (c=5) + the same net as play-out policy ("c5roll").
# vs previous mainline 5d+PV10 over 1000 paired seeds (eval500 + eval500b): 425 vs 383 wins, McNemar p=0.023.
# Gate new arms against eval500_prior_c5roll (216/500) / eval500b_prior_c5roll (209/500).
MAINLINE_POLICY=nets/rl5d/pol_gate.npz
MAINLINE_ENV="MACRO_MAPFEAT=1 POTION_VALUE=10 HONEST_ROOT_NET=nets/exi1/rollout.npz HONEST_ROOT_C=5 HONEST_ROLLOUT_NET=nets/exi1/rollout.npz"
MAINLINE_EVAL500=eval500_prior_c5roll
